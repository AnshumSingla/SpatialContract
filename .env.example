# Nebius Token Factory credentials. Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Hard cumulative token cap across ALL runs (ledger in results/token_ledger.json)
SC_TOKEN_CAP=200000
